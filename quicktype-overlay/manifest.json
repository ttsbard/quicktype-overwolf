{
  "manifest_version": 1,
  "type": "WebApp",
  "meta": {
    "name": "QuickType",
    "author": "QuickType",
    "version": "0.5.2",
    "minimum-overwolf-version": "0.250.0",
    "description": "Universal in-game quick input overlay with REST API & webhook integration.",
    "dock_button_title": "QuickType",
    "icon": "icon.png",
    "icon_gray": "icon-gray.png",
    "launcher_icon": "icon.ico",
    "window_icon": "icon.png"
  },
  "permissions": [
    "Hotkeys",
    "GameInfo",
    "FileSystem",
    "Web"
  ],
  "data": {
    "start_window": "background",
    "game_targeting": {
      "type": "all"
    },
    "hotkeys": {
      "toggle_input_form": {
        "title": "Toggle QuickType input overlay",
        "action-type": "custom",
        "default": "Ctrl+T",
        "passthrough": false
      }
    },
    "windows": {
      "background": {
        "file": "background.html",
        "is_background_page": true
      },
      "desktop": {
        "file": "desktop.html",
        "desktop_only": true,
        "native_window": true,
        "resizable": false,
        "transparent": false,
        "show_in_taskbar": true,
        "size": {
          "width": 600,
          "height": 750
        },
        "min_size": {
          "width": 600,
          "height": 700
        },
        "max_size": {
          "width": 600,
          "height": 750
        }
      },
      "overlay": {
        "file": "overlay.html",
        "transparent": true,
        "resizable": true,
        "show_in_taskbar": false,
        "in_game_only": false,
        "grab_keyboard_focus": true,
        "focus_game_takeover": "ReleaseOnHidden",
        "focus_game_takeover_release_hotkey": "toggle_input_form",
        "size": {
          "width": 640,
          "height": 100
        },
        "min_size": {
          "width": 240,
          "height": 60
        },
        "max_size": {
          "width": 1920,
          "height": 1080
        }
      }
    },
    "developer": {
      "enable_auto_refresh": true,
      "reload_delay": 1000,
      "filter": "*.*"
    }
  }
}
